{
  "name": "multiterm",
  "version": "0.1.0",
  "description": "Central visual para executar e acompanhar varios terminais/agentes simultaneamente",
  "license": "MIT",
  "desktopName": "multiterm.desktop",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "test": "node scripts/build.mjs --tests && node --test 'dist/test/unit/*.test.js'",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "postinstall": "electron-rebuild -f -w node-pty",
    "smoke": "npm run build && electron dist/test/pty-smoke.js --no-sandbox",
    "start:no-sandbox": "npm run build && electron . --no-sandbox",
    "app:install": "npm run build && node scripts/install-desktop.mjs",
    "app:uninstall": "node scripts/install-desktop.mjs --uninstall",
    "dist": "npm run build && mkdir -p build && node scripts/make-icon.mjs build/icon.png 512 && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^22.10.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2"
  }
}
