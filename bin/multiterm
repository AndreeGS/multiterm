#!/usr/bin/env bash
# Lancador do MultiTerm. Resolve o diretorio do projeto a partir da propria
# localizacao, entao funciona por symlink (~/.local/bin/multiterm) e pelo
# atalho do menu de aplicativos.
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *) SELF="$(dirname "$SELF")/$TARGET" ;;
  esac
done
APP_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"

cd "$APP_DIR"

# Sem dependencias o erro do Electron seria obscuro: diz o que fazer.
if [ ! -x node_modules/.bin/electron ]; then
  echo "multiterm: dependencias ausentes. Rode 'npm install' em $APP_DIR" >&2
  exit 1
fi

# Primeira execucao ainda nao tem bundle; depois de um git pull o bundle fica
# velho. Recompila se algum fonte for mais novo que ele.
if [ ! -f dist/main/main.js ] || [ -n "$(find src scripts/build.mjs -newer dist/main/main.js -print -quit)" ]; then
  npm run build >&2
fi

ARGS=()
# O chrome-sandbox so funciona com setuid root. Sem isso o Chromium aborta —
# entao caimos para --no-sandbox em vez de falhar na cara do usuario.
if [ ! -u node_modules/electron/dist/chrome-sandbox ]; then
  echo "multiterm: chrome-sandbox sem setuid root; rodando com --no-sandbox (veja o README para ativar)" >&2
  ARGS+=(--no-sandbox)
fi

# --class casa com StartupWMClass no .desktop, para a janela agrupar no icone certo.
exec node_modules/.bin/electron "$APP_DIR" --class=MultiTerm "${ARGS[@]}" "$@"
